BIND_ADDRESS=0.0.0.0
PORT=5080
# Empty = use the address opened in the browser (LAN IP, hostname, mapped port).
PUBLIC_ORIGIN=
COOKIE_SECURE=false
READ_ONLY=true
DOCKER_SOCKET=/var/run/docker.sock
# Linux: stat -c '%g' /var/run/docker.sock
DOCKER_GID=0
SERVER_LABEL=Docker server
UPDATE_INTERVAL=5
SESSION_TTL=28800
